local Hitbox = {
    On = false,
    All = false,
    TeamBlue = false,
    TeamRed = false,
    Names = {},
    Size = 10,
    Token = 0,
    Orig = setmetatable({}, { __mode = "k" }),
}

local Players = game:GetService("Players")
local LP = Players.LocalPlayer

local function GetRoot(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function HitboxRestore(root)
    local o = Hitbox.Orig[root]
    if not o then return end
    Hitbox.Orig[root] = nil
    if root.Parent then
        root.Size = o.Size
        root.Transparency = o.Transparency
        root.Color = o.Color
        root.Material = o.Material
        root.CanCollide = o.CanCollide
    end
end

local function HitboxRestoreAll()
    for root in pairs(Hitbox.Orig) do HitboxRestore(root) end
end

local function HitboxTick()
    local size = Vector3.new(Hitbox.Size, Hitbox.Size, Hitbox.Size)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            local root = GetRoot(char)
            if root then
                -- Team checks based on the vests
                local isBlue = Hitbox.TeamBlue and char:FindFirstChild("Vest_blue", true) ~= nil
                local isRed = Hitbox.TeamRed and char:FindFirstChild("Vest_red", true) ~= nil
                
                if Hitbox.All or Hitbox.Names[plr.Name] or isBlue or isRed then
                    if not Hitbox.Orig[root] then
                        Hitbox.Orig[root] = {
                            Size = root.Size,
                            Transparency = root.Transparency,
                            Color = root.Color,
                            Material = root.Material,
                            CanCollide = root.CanCollide,
                        }
                    end
                    if root.Size ~= size then root.Size = size end
                    if root.Transparency ~= 0.7 then root.Transparency = 0.7 end
                    if root.Material ~= Enum.Material.Neon then root.Material = Enum.Material.Neon end
                    if root.CanCollide then root.CanCollide = false end
                    root.Color = Color3.fromRGB(13, 105, 172)
                elseif Hitbox.Orig[root] then
                    HitboxRestore(root)
                end
            end
        end
    end
end

local function SetHitbox(on)
    Hitbox.On = on
    Hitbox.Token = Hitbox.Token + 1
    if on then
        local token = Hitbox.Token
        task.spawn(function()
            while Hitbox.On and token == Hitbox.Token do
                pcall(HitboxTick)
                task.wait(0.15)
            end
        end)
    else
        HitboxRestoreAll()
    end
end

if OnCleanup then OnCleanup(function() SetHitbox(false) end) end

