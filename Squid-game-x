})

-- ==========================================
-- OPTIMIZED CORE LOOP (NO LAG)
-- ==========================================
local updateAccumulator = 0
RunService.Heartbeat:Connect(function(dt)
    -- Only process if at least one feature is active
    if not HitboxConfig.On and not ESPConfig.All and not ESPConfig.Player and not ESPConfig.Detective and not ESPConfig.Guard and not ESPConfig.Blue and not ESPConfig.Red then return end
    
    -- Throttle to 10 ticks per second (0.1s) to guarantee zero lag
    updateAccumulator = updateAccumulator + dt
    if updateAccumulator < 0.1 then return end
    updateAccumulator = 0

    local size = Vector3.new(HitboxConfig.Size, HitboxConfig.Size, HitboxConfig.Size)
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local root = char.HumanoidRootPart
                
                -- Team Service Checks
                local teamName = plr.Team and plr.Team.Name or "NoTeam"
                local isPlayerTeam = (teamName == "Player")
                local isDetective = (teamName == "Detective")
                local isGuard = (teamName == "Guard")
                
                -- Vest Checks (for Hide & Seek)
                local hasBlue = char:FindFirstChild("Vest_blue", true) ~= nil
                local hasRed = char:FindFirstChild("Vest_red", true) ~= nil
                
                activeHighlights[char] = activeHighlights[char] or {}

                -- ESP Logic
                local function updateESP(espType, color, enabled)
                    if enabled then
                        if not activeHighlights[char][espType] or not activeHighlights[char][espType].Parent then
                            local hl = Instance.new("Highlight")
                            hl.Name = espType .. "ESP"
                            hl.FillColor = color; hl.OutlineColor = color
                            hl.FillTransparency = 0.5; hl.OutlineTransparency = 0
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Adornee = char; hl.Parent = char
                            activeHighlights[char][espType] = hl
                        end
                    elseif activeHighlights[char][espType] then
                        activeHighlights[char][espType]:Destroy()
                        activeHighlights[char][espType] = nil
                    end
                end

                -- Apply ESP based on toggles (UPDATED COLORS)
                updateESP("All", Color3.fromRGB(0, 255, 0), ESPConfig.All)                              -- Green
                updateESP("Player", Color3.fromRGB(255, 255, 255), ESPConfig.Player and isPlayerTeam)    -- White
                updateESP("Detective", Color3.fromRGB(255, 215, 0), ESPConfig.Detective and isDetective) -- Gold
                updateESP("Guard", Color3.fromRGB(255, 105, 180), ESPConfig.Guard and isGuard)           -- Pink
                updateESP("Blue", Color3.fromRGB(0, 170, 255), ESPConfig.Blue and hasBlue)               -- Light Blue
                updateESP("Red", Color3.fromRGB(255, 0, 0), ESPConfig.Red and hasRed)                    -- Red

                -- Hitbox Logic (ADDED HitboxConfig.Detective)
                if HitboxConfig.On then
                    local shouldHitbox = HitboxConfig.All or HitboxConfig.Names[plr.Name] or 
                                         (HitboxConfig.TeamBlue and (isPlayerTeam or hasBlue)) or 
                                         (HitboxConfig.TeamRed and (isDetective or hasRed)) or 
                                         (HitboxConfig.Guard and isGuard) or
                                         (HitboxConfig.Detective and isDetective)
                    
                    if shouldHitbox then
                        if not HitboxConfig.Orig[root] then
                            HitboxConfig.Orig[root] = {Size = root.Size, Transparency = root.Transparency, Color = root.Color, Material = root.Material, CanCollide = root.CanCollide}
                        end
                        if root.Size ~= size then root.Size = size end
                        if root.Transparency ~= 0.7 then root.Transparency = 0.7 end
                        if root.Material ~= Enum.Material.Neon then root.Material = Enum.Material.Neon end
                        if root.CanCollide then root.CanCollide = false end
                        root.Color = Color3.fromRGB(13, 105, 172)
                    elseif HitboxConfig.Orig[root] then
                        local o = HitboxConfig.Orig[root]
                        HitboxConfig.Orig[root] = nil
                        if root.Parent then
                            root.Size = o.Size; root.Transparency = o.Transparency
                            root.Color = o.Color; root.Material = o.Material; root.CanCollide = o.CanCollide
                        end
                    end
                end
            end
        end
    end
end)
