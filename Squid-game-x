PlayerGame:Section("Glass")

local glassEspEnabled = false
local glassHighlights = {}
local connections = {}
local cachedGlassesFolder = nil

local function clearGlassESP()
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(connections)

    for _, hl in pairs(glassHighlights) do
        pcall(function() hl:Destroy() end)
    end
    table.clear(glassHighlights)
    cachedGlassesFolder = nil
end

local function applyHighlight(part)
    if not part:IsA("BasePart") or glassHighlights[part] then return end

    local hl = Instance.new("Highlight")
    hl.Name = "KazeGlassESP"
    hl.Adornee = part
    hl.FillTransparency = 0.4
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    local function updateColor()
        if part.CanCollide then
            hl.FillColor = Color3.fromRGB(0, 255, 0)
            hl.OutlineColor = Color3.fromRGB(0, 255, 0)
        else
            hl.FillColor = Color3.fromRGB(255, 0, 0)
            hl.OutlineColor = Color3.fromRGB(255, 0, 0)
        end
    end

    updateColor()
    hl.Parent = part
    glassHighlights[part] = hl

    -- Instantly update color only when CanCollide changes, instead of checking every second
    table.insert(connections, part:GetPropertyChangedSignal("CanCollide"):Connect(updateColor))
end

local function setupFolder(folder)
    cachedGlassesFolder = folder

    -- Apply to existing parts
    for _, part in ipairs(folder:GetDescendants()) do
        applyHighlight(part)
    end

    -- Instantly apply to newly spawned parts without a loop
    table.insert(connections, folder.DescendantAdded:Connect(function(part)
        if glassEspEnabled then
            applyHighlight(part)
        end
    end))
end

PlayerGame:Toggle({
    Title = "Glass ESP",
    Default = false,
    Callback = function(Value)
        glassEspEnabled = Value
        clearGlassESP()

        if not glassEspEnabled then return end

        task.spawn(function()
            -- Try to find existing map folder
            local folder = workspace:FindFirstChild("Glasses", true) or workspace:FindFirstChild("Glass", true)
            
            if folder then
                setupFolder(folder)
                return
            end

            -- If the map hasn't loaded yet, wait for it silently without lagging the game
            local waitConn
            waitConn = workspace.DescendantAdded:Connect(function(inst)
                if not glassEspEnabled then
                    waitConn:Disconnect()
                    return
                end
                if inst.Name == "Glasses" or inst.Name == "Glass" then
                    if inst:IsA("Folder") or inst:IsA("Model") then
                        waitConn:Disconnect()
                        setupFolder(inst)
                    end
                end
            end)
            
            table.insert(connections, waitConn)
        end)
    end
})
