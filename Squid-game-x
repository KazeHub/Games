Copy.Font = Enum.Font.GothamBold
Copy.Parent = Main
Instance.new("UICorner", Copy).CornerRadius = UDim.new(0, 8)

Copy.MouseButton1Click:Connect(function()
    if setclipboard then
        local success = pcall(setclipboard, Link)
        Copy.Text = success and "LINK COPIED!" or "COPY FAILED"
    else
        Copy.Text = "CLIPBOARD NOT SUPPORTED"
    end
    task.delay(2, function()
        if Copy.Parent then Copy.Text = "COPY SCRIPT LINK" end
    end)
end)

Close.MouseButton1Click:Connect(function()
    local tween = TweenService:Create(Main, TweenInfo.new(0.2), {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(300, 200)
    })
    tween:Play()
    tween.Completed:Wait()
    ScreenGui:Destroy()
end)

Main.Size = UDim2.fromOffset(300, 200)
TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Back), {
    Size = UDim2.fromOffset(340, 235)
}):Play()
