local espState = {
    highlights = {},
    conn = nil,
}

local function setDoorESP(state)
    local exitDoors = workspace:FindFirstChild("Map")
        and workspace.Map:FindFirstChild("HideNSeek")
        and workspace.Map.HideNSeek:FindFirstChild("Elements")
        and workspace.Map.HideNSeek.Elements:FindFirstChild("ExitDoors")

    if not exitDoors then return end

    if not state then
        if espState.conn then espState.conn:Disconnect() espState.conn = nil end
        for _, hl in pairs(espState.highlights) do
            if hl then hl:Destroy() end
        end
        espState.highlights = {}
        return
    end

    local function apply(model)
        if not model:IsA("Model") then return end
        if espState.highlights[model] then return end

        local hl = Instance.new("Highlight")
        hl.Name                = "DoorESP"
        hl.FillColor           = Color3.new(1, 1, 1)
        hl.OutlineColor        = Color3.new(1, 1, 1)
        hl.FillTransparency    = 0.5
        hl.OutlineTransparency = 0
        hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee             = model
        hl.Parent              = model

        espState.highlights[model] = hl
    end

    for _, m in ipairs(exitDoors:GetChildren()) do
        apply(m)
    end

    espState.conn = exitDoors.ChildAdded:Connect(apply)
end

PlayerGame:Toggle({
    Title = "ESP Door",
    Default = false,
    Callback = setDoorESP
})

local espBlueOn = false
local espRedOn = false
local espHighlights = {}

task.spawn(function()
    while task.wait(0.5) do
        local players = game:GetService("Players"):GetPlayers()
        
        for _, plr in ipairs(players) do
            local char = plr.Character
            if char and char:FindFirstChild("Humanoid") then
                local hasBlue = char:FindFirstChild("Vest_blue", true) ~= nil
                local hasRed = char:FindFirstChild("Vest_red", true) ~= nil
                
                espHighlights[plr] = espHighlights[plr] or {}
                
                -- Blue Team ESP
                if espBlueOn and hasBlue then
                    if not espHighlights[plr].Blue or not espHighlights[plr].Blue.Parent then
                        local hl = Instance.new("Highlight")
                        hl.Name = "BlueTeamESP"
                        hl.FillColor = Color3.fromRGB(0, 170, 255)
                        hl.OutlineColor = Color3.fromRGB(0, 170, 255)
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = char
                        hl.Parent = char
                        espHighlights[plr].Blue = hl
                    end
                elseif espHighlights[plr].Blue then
                    espHighlights[plr].Blue:Destroy()
                    espHighlights[plr].Blue = nil
                end
                
                -- Red Team ESP
                if espRedOn and hasRed then
                    if not espHighlights[plr].Red or not espHighlights[plr].Red.Parent then
                        local hl = Instance.new("Highlight")
                        hl.Name = "RedTeamESP"
                        hl.FillColor = Color3.fromRGB(255, 0, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = char
                        hl.Parent = char
                        espHighlights[plr].Red = hl
                    end
                elseif espHighlights[plr].Red then
                    espHighlights[plr].Red:Destroy()
                    espHighlights[plr].Red = nil
                end
            end
        end
        
        -- Cleanup for players who leave or die
        for plr, hls in pairs(espHighlights) do
            if not plr.Parent or not plr.Character then
                if hls.Blue then hls.Blue:Destroy() end
                if hls.Red then hls.Red:Destroy() end
                espHighlights[plr] = nil
            end
        end
    end
end)

