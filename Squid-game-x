local autoBurnEnabled = false
local burnConnection = nil

GuardTab:Toggle({
    Title = "Auto Burn Coffins",
    Default = false,
    Callback = function(state)
        autoBurnEnabled = state
        
        if burnConnection then 
            task.cancel(burnConnection) 
            burnConnection = nil 
        end
        
        if not autoBurnEnabled then return end
        
        burnConnection = task.spawn(function()
            local pos1 = CFrame.new(8119, 82, 3578)
            local pos2 = CFrame.new(8115, 81, 3551)
            local pos2Vector = Vector3.new(8115, 81, 3551)
            
            while autoBurnEnabled do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                local data = workspace:FindFirstChild("Data")
                local incRoom = data and data:FindFirstChild("IncinerationRoom")
                local pickupFolder = incRoom and incRoom:FindFirstChild("PickupCoffins")
                
                if not hrp or not pickupFolder or #pickupFolder:GetChildren() == 0 then
                    break 
                end
                
                hrp.CFrame = pos1
                task.wait(0.2) 
                
                for _, child in ipairs(pickupFolder:GetChildren()) do
                    local prompt = child:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt and prompt.Enabled then
                        pcall(function()
                            if fireproximityprompt then fireproximityprompt(prompt) else prompt:InputHoldBegin(); task.wait(prompt.HoldDuration + 0.05); prompt:InputHoldEnd() end
                        end)
                        break
                    end
                end
                
                task.wait(0.2)
                
                hrp.CFrame = pos2
                task.wait(0.2)
                
                local nearestPrompt = nil
                local shortestDist = 5
                
                if incRoom then
                    for _, desc in ipairs(incRoom:GetDescendants()) do
                        if desc:IsA("ProximityPrompt") then
                            local parentPart = desc.Parent
                            if parentPart and parentPart:IsA("BasePart") then
                                local dist = (parentPart.Position - pos2Vector).Magnitude
                                if dist <= 5 and dist < shortestDist then
                                    shortestDist = dist
                                    nearestPrompt = desc
                                end
                            end
                        end
                    end
                end
                
                if nearestPrompt and nearestPrompt.Enabled then
                    pcall(function()
                        if fireproximityprompt then fireproximityprompt(nearestPrompt) else nearestPrompt:InputHoldBegin(); task.wait(nearestPrompt.HoldDuration + 0.05); nearestPrompt:InputHoldEnd() end
                    end)
                end
                task.wait(3)
            end
        end)
    end
})

