local espState = { highlights = {}, conn = nil }
local function setDoorESP(state)
    local exitDoors = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("HideNSeek") and Workspace.Map.HideNSeek:FindFirstChild("Elements") and Workspace.Map.HideNSeek.Elements:FindFirstChild("ExitDoors")
    if not exitDoors then return end
    if not state then
        if espState.conn then espState.conn:Disconnect() espState.conn = nil end
        for _, hl in pairs(espState.highlights) do if hl then hl:Destroy() end end
        espState.highlights = {}
        return
    end
    local function apply(model)
        if not model:IsA("Model") or espState.highlights[model] then return end
        local hl = Instance.new("Highlight")
        hl.Name = "DoorESP"; hl.FillColor = Color3.new(1, 1, 1); hl.OutlineColor = Color3.new(1, 1, 1)
        hl.FillTransparency = 0.5; hl.OutlineTransparency = 0; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = model; hl.Parent = model; espState.highlights[model] = hl
    end
    for _, m in ipairs(exitDoors:GetChildren()) do apply(m) end
    espState.conn = exitDoors.ChildAdded:Connect(apply)
end


PlayerGame:Toggle({ Title = "ESP Door", Default = false, Callback = setDoorESP })

