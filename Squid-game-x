    Title = "ESP Evidence",
    Default = false,
    Callback = function(state)
        evidenceEspEnabled = state
        clearEvidenceESP()
        
        if not evidenceEspEnabled then return end
        
        task.spawn(function()
            local data = workspace:FindFirstChild("Data")
            local detective = data and data:FindFirstChild("Detective")
